                  {
                    "value": "   Customer Lifetime Value Analysis",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "21pt",
                      "fontWeight": "bold",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "   Apr 11, 2023 - Jun 10, 2023   |   1,000 transactions   |   946 customers   |   4 cities",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
