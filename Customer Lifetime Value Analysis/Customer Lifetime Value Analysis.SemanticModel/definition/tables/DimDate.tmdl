	column 'DayOfWeek Number'
		isHidden
		formatString: 0
		lineageTag: b9c9cd7f-d31c-4d35-9aee-ceac1745a2d2
		summarizeBy: none
		isNameInferred
		sourceColumn: [DayOfWeek Number]

		annotation SummarizationSetBy = User

	partition DimDate = calculated
		mode: import
		source =
				VAR MinDate = MIN( FactTransactions[PurchaseDate] )
				VAR MaxDate = MAX( FactTransactions[PurchaseDate] )
				VAR BaseCalendar = CALENDAR( MinDate, MaxDate )
				RETURN
					ADDCOLUMNS(
						BaseCalendar,
						"Year", YEAR( [Date] ),
						"Month", FORMAT( [Date], "MMMM", "en-US" ),
						"Month Number", MONTH( [Date] ),
						"Month Short", FORMAT( [Date], "MMM", "en-US" ),
						"YearMonth", FORMAT( [Date], "yyyy-MM", "en-US" ),
						"YearMonth Sort", YEAR( [Date] ) * 100 + MONTH( [Date] ),
						"Day", DAY( [Date] ),
						"Week", WEEKNUM( [Date], 2 ),
						"YearWeek",
							FORMAT( YEAR( [Date] ), "0000", "en-US" ) & "-W"
								& FORMAT( WEEKNUM( [Date], 2 ), "00", "en-US" ),
						"DayOfWeek", FORMAT( [Date], "dddd", "en-US" ),
						"DayOfWeek Number", WEEKDAY( [Date], 2 )
					)

