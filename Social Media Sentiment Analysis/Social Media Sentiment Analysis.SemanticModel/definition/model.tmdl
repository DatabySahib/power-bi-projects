model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: tr-TR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["FactSocialSentiment","DimGeography","DimAgeGroup"]

ref table FactSocialSentiment
ref table DimGeography
ref table DimAgeGroup
ref table _Measures

ref cultureInfo en-US

