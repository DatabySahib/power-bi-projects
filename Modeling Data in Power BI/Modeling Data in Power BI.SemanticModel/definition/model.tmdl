model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: tr-TR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["NorthwindFolder","categories","products","customers","employees","shippers","orders","order_details"]

ref table categories
ref table customers
ref table employees
ref table products
ref table shippers
ref table orders
ref table order_details
ref table _Measures

ref cultureInfo en-US

